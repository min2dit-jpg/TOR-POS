**/bin/
**/obj/

# R123: build and release outputs. They are regenerated by
# 1-SETUP-ERSTELLEN.bat on every build; keeping them in Git added a 44 MB
# installer and ~240 runtime DLLs to history with every release. Hand an
# installer to customers through a GitHub Release instead.
publish/
installer-output/
TOR-POS-build.log
TOR-POS-installer-build.log
TOR-POS-build-timing.txt

# Generated single-file source bundles - Git itself is now the source of truth.
TOR-POS-Pro-Source.zip
TOR-POS-Pro-Kaynak-Kod.txt

# Local runtime data, secrets and the private licence signing key.
*.torlic
*.pfx
*.p12
dealer-tools/**/*.pem
!dealer-tools/TOR-POS-LICENSE-PUBLIC.pem
.env
.vs/
.idea/
Thumbs.db
desktop.ini
