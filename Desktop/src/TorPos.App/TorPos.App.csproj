<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Split-product foundation: the same audited application code can be
         published as a fixed TOR KIOSK or TOR DÖNER executable. The default
         remains the R181-compatible shared build until migration qualification
         is complete. -->
    <TorProductEdition Condition="'$(TorProductEdition)' == ''">SHARED</TorProductEdition>
    <AssemblyName Condition="'$(TorProductEdition)' == 'KIOSK'">TOR-KIOSK</AssemblyName>
    <AssemblyName Condition="'$(TorProductEdition)' == 'IMBISS'">TOR-DOENER</AssemblyName>
    <DefineConstants Condition="'$(TorProductEdition)' == 'KIOSK'">$(DefineConstants);TOR_KIOSK_PRODUCT</DefineConstants>
    <DefineConstants Condition="'$(TorProductEdition)' == 'IMBISS'">$(DefineConstants);TOR_DOENER_PRODUCT</DefineConstants>
    <!-- R126: had drifted to 0.7.33.751 / "R75.1-Application-Namespace-Hotfix"
         - the version Windows shows in the exe's file properties. Keep in step
         with TorPos.Core.TorRelease, TOR-POS-Pro-Setup.iss and manifest.json. -->
    <Version>0.7.33.881</Version>
    <FileVersion>0.7.33.881</FileVersion>
    <InformationalVersion>0.7.33.881-R181-Merd-M</InformationalVersion>
    <InformationalVersion Condition="'$(TorDemoBuild)' == 'true'">0.7.33.881-R181-Merd-M-DEMO</InformationalVersion>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationIcon>Assets\TorPos.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>

    <!-- R72.5:
         LoginWindow/MainWindow/SettingsWindow are DI/factory-created TopLevel
         windows and intentionally have no public parameterless constructor.
         AVLN3001 is therefore treated as an MSBuild message, not a warning.
         Do not add dummy constructors only to satisfy the runtime-loader warning. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);AVLN3001</MSBuildWarningsAsMessages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TorPos.Core\TorPos.Core.csproj" />
    <ProjectReference Include="..\TorPos.Application\TorPos.Application.csproj" />
    <ProjectReference Include="..\TorPos.Infrastructure\TorPos.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\THIRD-PARTY-NOTICES.md"
          Link="Dokumentation\THIRD-PARTY-NOTICES.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\NUTZUNGSBEDINGUNGEN-DE.txt"
          Link="Dokumentation\NUTZUNGSBEDINGUNGEN-DE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\VERFAHRENSDOKUMENTATION-TEMPLATE-DE.md"
          Link="Dokumentation\VERFAHRENSDOKUMENTATION-TEMPLATE-DE.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\TorPos-Brand.jpg" />
    <None Update="Assets\TorPos-Magnifier.png"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
