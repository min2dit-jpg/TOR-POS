# R125: systemd unit for a Linux server. Installed by deploy/install-cloud.sh,
# which also creates the user, the folders listed in ReadWritePaths (systemd
# refuses to start when one is missing) and /etc/tor-pos-cloud.env (chmod 600).
# See docs/CLOUD-PRODUKTION.md.
#
#   journalctl -u tor-pos-cloud -f
#
# The server only listens on 127.0.0.1. TLS is terminated by the reverse proxy
# in front of it (see deploy/Caddyfile.example); nothing talks to Node directly.

[Unit]
Description=TOR POS Cloud
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=torcloud
Group=torcloud
WorkingDirectory=/opt/tor-pos-cloud
EnvironmentFile=/etc/tor-pos-cloud.env
ExecStart=/usr/bin/node server.js
# server.js closes the HTTP server and the database cleanly on SIGTERM (R120).
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=5

# Hardening: the process may only write its data, backup and update folders.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tor-pos-cloud/data /opt/tor-pos-cloud/updates /var/backups/tor-pos-cloud

[Install]
WantedBy=multi-user.target
