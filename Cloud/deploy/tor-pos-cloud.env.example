# R125: production environment for TOR POS Cloud. Copy to /etc/tor-pos-cloud.env,
# chmod 600, and replace EVERY placeholder (deploy/install-cloud.sh does the copy
# and chmod). server.js refuses to start in live mode when a security-relevant
# value is missing, too short or still a placeholder (REPLACE-WITH..., CHANGE-ME,
# PLACEHOLDER), and when TOR_CLOUD_PUBLIC_URL is HTTPS without COOKIE_SECURE=true.
# Check before going live: sudo bash deploy/preflight-cloud.sh

# Listen only locally; the reverse proxy is the public side.
HOST=127.0.0.1
PORT=8787

# Live mode. The demo database (TOR-DEMO-001) cannot be opened with this.
TOR_CLOUD_DEMO=false
COOKIE_SECURE=true
# R145: the API/portal domain; the digital receipt needs a domain of its own.
TOR_CLOUD_PUBLIC_URL=https://api.torpos.de

# Behind the reverse proxy the socket address is always the proxy's, so the
# login rate limiter needs X-Forwarded-For (R120). Only true behind a proxy
# that overwrites that header - never when Node is reachable directly.
TOR_CLOUD_TRUST_PROXY=true

# Owner 2FA is required in live mode. Generate with: openssl rand -base64 36
TOR_CLOUD_TOTP_KEY=REPLACE-WITH-AT-LEAST-24-RANDOM-CHARACTERS

# R145: TOR Digital Receipt Cloud - the customer's copy of a receipt behind a
# QR code (docs/DIGITALER-KASSENBON.md). Its own domain, different from
# TOR_CLOUD_PUBLIC_URL; HTTPS only. Empty = the tills cannot offer it.
TOR_CLOUD_RECEIPT_URL=https://bon.torpos.de
# Days a receipt link stays available; afterwards token, PDF and content are
# deleted. No legal rule fixes this period (data minimisation, Art. 5 DSGVO);
# it is NOT the retention of the fiscal records, which stay on the till.
TOR_CLOUD_RECEIPT_TTL_DAYS=90
# Impressum (§ 5 DDG) and privacy notice (Art. 13 DSGVO) linked on the receipt domain.
TOR_CLOUD_IMPRINT_URL=https://torpos.de/impressum
TOR_CLOUD_PRIVACY_URL=https://torpos.de/datenschutz

# Database and update files.
TOR_CLOUD_DB=/opt/tor-pos-cloud/data/tor-cloud.db
TOR_CLOUD_UPDATES=/opt/tor-pos-cloud/updates

# R125: consistent backup (VACUUM INTO) while running. Copy this folder off the
# server as well - a backup on the same disk does not survive losing the disk.
TOR_CLOUD_BACKUP_DIR=/var/backups/tor-pos-cloud
TOR_CLOUD_BACKUP_INTERVAL_HOURS=24
TOR_CLOUD_BACKUP_KEEP=14

# R155: TOR Mail - zentraler Versand für Berichte und DATEV-Dateien.
# Kundenkassen benötigen damit KEINE Google-Anmeldung und KEIN eigenes SMTP-
# Passwort. Diese Zugangsdaten bleiben ausschließlich in /etc/tor-pos-cloud.env
# auf dem Server (Dateirechte 600). Für Produktion einen TOR-eigenen Absender
# mit SPF/DKIM/DMARC verwenden, z. B. reports@torpos.de.
# Leer lassen = TOR Mail ist deaktiviert; der Cloud-Healthcheck meldet
# managed_mail_configured=false.
TOR_MAIL_SMTP_HOST=
TOR_MAIL_SMTP_PORT=587
TOR_MAIL_SMTP_MODE=starttls
TOR_MAIL_SMTP_USER=
TOR_MAIL_SMTP_PASSWORD=
TOR_MAIL_FROM=
TOR_MAIL_FROM_NAME=TOR POS
# Schutz gegen Missbrauch pro registrierter Kasse.
TOR_MAIL_HOURLY_LIMIT=20
TOR_MAIL_DAILY_LIMIT=100

# Optional: Google OAuth for Gmail report delivery (R62). Leave empty to disable.
TOR_GOOGLE_OAUTH_CLIENT_ID=
TOR_GOOGLE_OAUTH_CLIENT_SECRET=
TOR_CLOUD_GOOGLE_TOKEN_KEY=
