# R125/R145: HTTPS (TLS) in front of TOR POS Cloud with Caddy, which obtains and
# renews the Let's Encrypt certificates by itself and redirects HTTP to HTTPS
# automatically. Requirements: DNS names pointing at this server and ports
# 80/443 open. Replace api.torpos.de / bon.torpos.de / updates.torpos.de with
# the real domains and set the same names in /etc/tor-pos-cloud.env
# (TOR_CLOUD_PUBLIC_URL, TOR_CLOUD_RECEIPT_URL, TOR_UPDATE_PUBLIC_URL).
#
#   sudo cp deploy/Caddyfile.example /etc/caddy/Caddyfile && sudo systemctl reload caddy
#
# Three public origins:
#   api.<domain>      till <-> Cloud and customer portal
#   bon.<domain>      customer's digital receipt
#   updates.<domain>  TOR POS update discovery + signed installer download

api.torpos.de {
	encode gzip

	tls {
		protocols tls1.2 tls1.3
	}

	# Overwrite, never append: with TOR_CLOUD_TRUST_PROXY=true, server.js
	# (clientIp) uses the FIRST address in this header as the client, so a value
	# the client sent itself must not survive the proxy - otherwise anyone could
	# pick a fresh "IP" per login attempt and bypass the rate limiter.
	reverse_proxy 127.0.0.1:8787 {
		header_up X-Forwarded-For {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# Limits what clients may SEND (sync batches, logins, receipts), not downloads
	# such as installers. server.js rejects JSON bodies over 1 MB itself (413);
	# this just stops an oversized upload at the edge before it reaches Node.
	request_body {
		max_size 2MB
	}
}

updates.torpos.de {
	encode gzip

	tls {
		protocols tls1.2 tls1.3
	}

	# Only update discovery/download paths are expected on this origin.
	@updatePaths path /api/v1/updates/check /updates/*
	handle @updatePaths {
		reverse_proxy 127.0.0.1:8787 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		respond "Nicht gefunden" 404
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Update origin accepts no request body.
	request_body {
		max_size 16KB
	}
}

bon.torpos.de {
	tls {
		protocols tls1.2 tls1.3
	}

	# No "log" directive on purpose: the request path carries the receipt token,
	# which is the key to the receipt. server.js sets the security, noindex and
	# no-store headers on every response itself.
	reverse_proxy 127.0.0.1:8787 {
		header_up X-Forwarded-For {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# The receipt domain accepts no uploads.
	request_body {
		max_size 16KB
	}
}
