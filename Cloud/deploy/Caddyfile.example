# R125: HTTPS in front of TOR POS Cloud with Caddy, which obtains and renews the
# Let's Encrypt certificate by itself. Requirements: a DNS name pointing at
# this server and ports 80/443 open. Replace cloud.example.de.
#
#   sudo cp deploy/Caddyfile.example /etc/caddy/Caddyfile && sudo systemctl reload caddy

cloud.example.de {
	encode gzip

	# Overwrite, never append: with TOR_CLOUD_TRUST_PROXY=true, server.js
	# (clientIp) uses the FIRST address in this header as the client, so a value
	# the client sent itself must not survive the proxy - otherwise anyone could
	# pick a fresh "IP" per login attempt and bypass the rate limiter.
	reverse_proxy 127.0.0.1:8787 {
		header_up X-Forwarded-For {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
	}

	# Limits what clients may SEND (sync batches, logins), not downloads such as
	# installers. server.js rejects JSON bodies over 1 MB itself (413); this just
	# stops an oversized upload at the edge before it reaches Node.
	request_body {
		max_size 2MB
	}
}
