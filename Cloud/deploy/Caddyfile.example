# R125/R145: HTTPS (TLS) in front of TOR POS Cloud with Caddy, which obtains and
# renews the Let's Encrypt certificates by itself and redirects HTTP to HTTPS
# automatically. Requirements: DNS names pointing at this server and ports
# 80/443 open. Replace api.torpos.de / bon.torpos.de with the real domains and
# set the same names in /etc/tor-pos-cloud.env (TOR_CLOUD_PUBLIC_URL,
# TOR_CLOUD_RECEIPT_URL).
#
#   sudo bash deploy/apply-caddyfile.sh deploy/Caddyfile.example
#   (caddy validate first; the running file stays when validation or reload fails)
#
# Two security domains (R145, docs/DIGITALER-KASSENBON.md):
#   api.<domain>  till <-> Cloud, customer portal, updates - authentication required
#   bon.<domain>  the customer's digital receipt - no login, only the receipt token

api.torpos.de {
	encode gzip

	tls {
		protocols tls1.2 tls1.3
	}

	# Overwrite, never append: with TOR_CLOUD_TRUST_PROXY=true, server.js
	# (clientIp) uses the FIRST address in this header as the client, so a value
	# the client sent itself must not survive the proxy - otherwise anyone could
	# pick a fresh "IP" per login attempt and bypass the rate limiter.
	reverse_proxy 127.0.0.1:8787 {
		header_up X-Forwarded-For {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# Limits what clients may SEND (sync batches, logins, receipts), not downloads
	# such as installers. server.js rejects JSON bodies over 1 MB itself (413);
	# this just stops an oversized upload at the edge before it reaches Node.
	#
	# C-1: TOR Mail is the one exception. A till may send up to 8 MB of PDF/CSV
	# attachments (managed-mail.js), which base64 inflates to ~10.7 MB of JSON;
	# server.js accepts 12 MiB on that route. The two matchers are mutually
	# exclusive on purpose: request_body wraps the body once per matching
	# directive and the smallest wrap wins, so a catch-all 2MB would still cut
	# the mail route down to 2 MB.
	@torMail path /api/v1/devices/mail/send
	request_body @torMail {
		max_size 12MiB
	}
	@notTorMail not path /api/v1/devices/mail/send
	request_body @notTorMail {
		max_size 2MB
	}
}

bon.torpos.de {
	tls {
		protocols tls1.2 tls1.3
	}

	# No "log" directive on purpose: the request path carries the receipt token,
	# which is the key to the receipt. server.js sets the security, noindex and
	# no-store headers on every response itself.
	reverse_proxy 127.0.0.1:8787 {
		header_up X-Forwarded-For {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# The receipt domain accepts no uploads.
	request_body {
		max_size 16KB
	}
}
