# R127: the repository root is the whole project folder (Desktop/, Cloud/,
# Dokumentation/, verification/). Desktop/.gitignore and Cloud/.gitignore hold
# the rules for their own folders; this file only covers what applies
# everywhere.

# Build output of any .NET project
bin/
obj/

# Node
node_modules/

# Secrets and licence material, wherever they end up
.env
.env.*
!Cloud/deploy/tor-pos-cloud.env.example
*.pfx
*.p12
*.torlic

# Local editor / OS noise
.vs/
.idea/
.vscode/
Thumbs.db
desktop.ini


# fiskaltrust local launcher packages contain CashBox credentials/tokens.
# Keep them outside Git; use a local folder such as C:\fiskaltrust\TOR-POS.
fiskaltrust.service.launcher.*.zip
.fiskaltrust/
